// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js" // Mantén esto así
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  lastName  String   @db.VarChar(255)
  username  String   @db.VarChar(255) @unique
  email     String   @db.VarChar(255) @unique
  password  String   @db.VarChar(255)
  refreshToken String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 activeToken  String?  @db.Text
  tasks     Task[]
  logs      log[]  
   // relación inversa: un usuario puede tener varias tareas
}

model Task {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String   @db.Text
  priority    Boolean  @default(false)
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model log {
  id        Int      @id @default(autoincrement())
  statusCode Int   @db.Int
  path      String   @db.VarChar(255)
  error String   @db.Text
  timestamp DateTime @default(now())
  errorCode String   @db.VarChar(255)
  sessionId Int?  

   user User? @relation(fields: [sessionId], references: [id])
}